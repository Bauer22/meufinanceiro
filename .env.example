# PostgreSQL (Neon). Na Vercel use a URL com "-pooler" e ?sslmode=require (sem channel_binding).
DATABASE_URL="postgresql://usuario:senha@host:5432/meu_financeiro?sslmode=require"

# Senha de acesso ao app (obrigatória em produção).
APP_PASSWORD="troque-por-uma-senha-forte"

# Chave que assina o cookie de sessão. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="troque-por-um-texto-aleatorio-longo"
